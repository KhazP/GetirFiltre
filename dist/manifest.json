{
  "manifest_version": 3,
  "name": "GetirFiltre",
  "description": "God Mode for GetirYemek - Blacklist restaurants and apply advanced filters",
  "version": "1.0.0",
  "icons": {
    "128": "src/assets/icon.svg"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "128": "src/assets/icon.svg"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/index.tsx-loader-BbrkLLkQ.js"
      ],
      "matches": [
        "https://getir.com/yemek/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://getir.com/*"
      ],
      "resources": [
        "assets/storage-CE-gbFcj.js",
        "assets/index.tsx-CuJlrqH5.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
